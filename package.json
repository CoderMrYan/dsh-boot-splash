{
  "name": "dsh-boot-splash",
  "version": "0.1.0",
  "type": "module",
  "description": "Full-screen boot sequence and synthesized startup score for the DeepSeek Harness Web UI.",
  "license": "MIT",
  "author": "CoderMrYan",
  "homepage": "https://github.com/CoderMrYan/dsh-boot-splash#readme",
  "bugs": {
    "url": "https://github.com/CoderMrYan/dsh-boot-splash/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoderMrYan/dsh-boot-splash.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "boot-splash",
    "web-ui"
  ],
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "build": "node tools/scope-css.mjs && node tools/build.mjs",
    "test": "node --test test/apply.test.js test/bundle.test.js",
    "check": "node --check lib/index.js && node --check lib/boot.js"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
